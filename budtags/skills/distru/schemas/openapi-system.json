{
  "openapi": "3.0.3",
  "info": { "title": "Distru Public API - System", "version": "v1" },
  "servers": [{ "url": "https://app.distru.com/public/v1" }],
  "paths": {
    "/locations": {
      "get": {
        "operationId": "listLocations",
        "parameters": [
          { "$ref": "openapi-shared.json#/components/parameters/PageNumber" },
          { "name": "location_type", "in": "query", "schema": { "type": "string" } },
          { "name": "license_number", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Paginated locations" } }
      },
      "post": { "operationId": "createLocation", "responses": { "201": { "description": "Created (UPSERT)" } } }
    },
    "/locations/{id}": {
      "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
      "put": { "operationId": "updateLocation", "responses": { "200": { "description": "Updated" } } }
    },
    "/custom_fields": {
      "get": { "operationId": "listCustomFields", "responses": { "200": { "description": "Tenant custom field definitions" } } }
    },
    "/users": {
      "get": { "operationId": "listUsers", "responses": { "200": { "description": "Users" } } }
    },
    "/roles": {
      "get": { "operationId": "listRoles", "responses": { "200": { "description": "Roles" } } }
    },
    "/payment_methods": {
      "get": { "operationId": "listPaymentMethods", "responses": { "200": { "description": "Payment methods" } } }
    },
    "/pos_mappings": {
      "get": { "operationId": "listPosMappings", "responses": { "200": { "description": "POS system mappings (Blaze, Dutchie, Treez)" } } }
    }
  }
}
