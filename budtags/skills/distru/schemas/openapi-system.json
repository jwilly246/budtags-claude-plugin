{
  "openapi": "3.0.3",
  "info": { "title": "Distru Public API - System", "version": "v1", "description": "Phase 0.5 audited 2026-05-21. See categories/system.md for full field grids and RBAC permissions matrix. FIVE slug corrections live in this domain — kebab-case is in force." },
  "servers": [{ "url": "https://app.distru.com/public/v1" }],
  "paths": {
    "/strains": {
      "get": {
        "operationId": "listStrains",
        "description": "List strains. Page size 50,000 (highest cap in API). Eventually consistent ~1s. RBAC: settings_permissions_strains.",
        "parameters": [
          { "$ref": "openapi-shared.json#/components/parameters/PageNumber" },
          { "$ref": "openapi-shared.json#/components/parameters/PageSize" },
          { "$ref": "openapi-shared.json#/components/parameters/UpdatedDatetime" },
          { "$ref": "openapi-shared.json#/components/parameters/InsertedDatetime" },
          { "name": "name", "in": "query", "schema": { "type": "string" } },
          { "name": "type", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Paginated strains" } }
      },
      "post": { "operationId": "upsertStrain", "responses": { "200": { "description": "Created or updated" } } }
    },
    "/strains/{id}": {
      "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
      "get": { "operationId": "getStrain", "responses": { "200": { "description": "Single strain" } } }
    },
    "/users": {
      "get": {
        "operationId": "listUsers",
        "description": "List users. Page size 1,000. role is FREE-TEXT (tenant-customizable). deleted_at uses _at suffix (not _datetime). RBAC: settings_permissions_manage_team.",
        "parameters": [
          { "$ref": "openapi-shared.json#/components/parameters/PageNumber" },
          { "$ref": "openapi-shared.json#/components/parameters/PageSize" },
          { "$ref": "openapi-shared.json#/components/parameters/UpdatedDatetime" },
          { "$ref": "openapi-shared.json#/components/parameters/InsertedDatetime" },
          { "name": "email", "in": "query", "schema": { "type": "string" }, "description": "Substring match" }
        ],
        "responses": { "200": { "description": "Paginated users" } }
      }
    },
    "/users/{id}": {
      "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
      "get": { "operationId": "getUser", "responses": { "200": { "description": "Single user" } } }
    },
    "/menus": {
      "get": {
        "operationId": "listMenus",
        "description": "List menus. Page size 500. Menu line-items NOT exposed (only menu metadata).",
        "parameters": [
          { "$ref": "openapi-shared.json#/components/parameters/PageNumber" },
          { "$ref": "openapi-shared.json#/components/parameters/PageSize" },
          { "$ref": "openapi-shared.json#/components/parameters/UpdatedDatetime" },
          { "$ref": "openapi-shared.json#/components/parameters/InsertedDatetime" },
          { "name": "is_published", "in": "query", "schema": { "type": "boolean" } },
          { "name": "is_active", "in": "query", "schema": { "type": "boolean" } }
        ],
        "responses": { "200": { "description": "Paginated menus" } }
      }
    },
    "/menus/{id}": {
      "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
      "get": { "operationId": "getMenu", "responses": { "200": { "description": "Single menu" } } }
    },
    "/payment-methods": {
      "get": {
        "operationId": "listPaymentMethods",
        "description": "List payment methods. HYPHEN slug (/payment_methods returns 404). Page size 5,000. RBAC: settings_permissions_payment_methods.",
        "parameters": [
          { "$ref": "openapi-shared.json#/components/parameters/PageNumber" },
          { "$ref": "openapi-shared.json#/components/parameters/PageSize" },
          { "$ref": "openapi-shared.json#/components/parameters/UpdatedDatetime" },
          { "$ref": "openapi-shared.json#/components/parameters/InsertedDatetime" },
          { "name": "is_active", "in": "query", "schema": { "type": "boolean" } }
        ],
        "responses": { "200": { "description": "Paginated payment methods" } }
      }
    },
    "/payment-methods/{id}": {
      "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
      "get": { "operationId": "getPaymentMethod", "responses": { "200": { "description": "Single payment method" } } }
    },
    "/custom-fields": {
      "post": {
        "operationId": "createCustomFieldDefinition",
        "description": "HYPHEN slug, POST-ONLY (no GET). Returns INTEGER id. Read existing custom field definitions only via custom_data[] on entity responses. RBAC: settings_permissions_custom_fields.",
        "responses": { "200": { "description": "Custom field definition created" } }
      }
    },
    "/file-attachments": {
      "post": {
        "operationId": "uploadFileAttachment",
        "description": "HYPHEN slug, POST-ONLY (no GET). Multipart upload. One of 15 ref fields REQUIRED (order_id, invoice_id, purchase_id, company_id, contact_id, location_id, product_id, batch_id, package_id, assembly_id, test_result_id, request_id, task_id, stock_transfer_id, return_id, order_shipment_id, agent_chat_thread_id, ai_order_intake_id, ai_purchase_intake_id). HTTP 422 on storage quota exceeded.",
        "responses": {
          "200": { "description": "File attached" },
          "422": { "$ref": "openapi-shared.json#/components/responses/UnprocessableEntity" }
        }
      }
    }
  }
}
